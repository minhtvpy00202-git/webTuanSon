generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  passwordHash String
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@index([roleId])
  @@index([createdAt])
  @@map("users")
}

model CompanyInfo {
  id          Int             @id @default(1)
  companyName String          @default("Doanh nghiệp đang cập nhật")
  aboutUs     String
  mission     String
  vision      String          @default("Nội dung sứ mệnh đang được cập nhật.")
  phone       String
  email       String
  zaloLink    String?
  address     String
  branches    CompanyBranch[]
  heroSlides  HeroSlide[]

  @@map("company_info")
}

model CompanyBranch {
  id            Int         @id @default(autoincrement())
  companyInfoId Int         @default(1)
  name          String
  address       String
  phone         String?
  email         String?
  mapsLink      String?
  sortOrder     Int         @default(0)
  isShowroom    Boolean     @default(true)
  createdAt     DateTime    @default(now())
  companyInfo   CompanyInfo @relation(fields: [companyInfoId], references: [id], onDelete: Cascade)

  @@index([companyInfoId, sortOrder])
  @@map("company_branches")
}

model ContactInquiry {
  id              Int      @id @default(autoincrement())
  fullName        String
  phone           String
  email           String
  productInterest String?
  message         String
  status          String   @default("new")
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("contact_inquiries")
}

model Category {
  id        Int            @id @default(autoincrement())
  name      String
  slug      String         @unique
  parentId  Int?
  sortOrder Int            @default(0)
  parent    Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]     @relation("CategoryHierarchy")
  products  Product[]
  units     CategoryUnit[]

  @@index([parentId, sortOrder])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id            Int                @id @default(autoincrement())
  productCode   String             @unique
  name          String
  description   String
  specs         String?
  price         Decimal            @db.Decimal(12, 2)
  discountPrice Decimal?           @db.Decimal(12, 2)
  isPromotion   Boolean            @default(false)
  imageUrl      String
  categoryId    Int
  createdAt     DateTime           @default(now())
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitPrices    ProductUnitPrice[]
  images        ProductImage[]

  @@index([categoryId])
  @@index([isPromotion])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id          Int      @id @default(autoincrement())
  productId   Int
  imageUrl    String
  storagePath String?
  isMain      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, imageUrl])
  @@index([productId, sortOrder])
  @@map("product_images")
}

model CategoryUnit {
  id            Int                @id @default(autoincrement())
  categoryId    Int
  label         String
  sortOrder     Int                @default(0)
  isDefault     Boolean            @default(false)
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productPrices ProductUnitPrice[]

  @@unique([categoryId, label])
  @@index([categoryId, sortOrder])
  @@map("category_units")
}

model ProductUnitPrice {
  id             Int          @id @default(autoincrement())
  productId      Int
  categoryUnitId Int
  price          Decimal      @db.Decimal(12, 2)
  discountPrice  Decimal?     @db.Decimal(12, 2)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryUnit   CategoryUnit @relation(fields: [categoryUnitId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryUnitId])
  @@index([productId])
  @@index([categoryUnitId])
  @@map("product_unit_prices")
}

model HeroSlide {
  id            Int         @id @default(autoincrement())
  companyInfoId Int         @default(1)
  imageUrl      String
  storagePath   String?
  sortOrder     Int         @default(0)
  heading       String?
  subheading    String?
  ctaText       String?
  ctaLink       String?
  createdAt     DateTime    @default(now())
  companyInfo   CompanyInfo @relation(fields: [companyInfoId], references: [id], onDelete: Cascade)

  @@index([companyInfoId, sortOrder])
  @@map("hero_slides")
}
